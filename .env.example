# ==========================================
# إعدادات الخادم الأساسية (مثال توضيحي)
# ==========================================
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# ==========================================
# إعدادات قاعدة البيانات (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nilus_eca
DATABASE_SSL=false

# ==========================================
# بيانات الاعتماد والاتصال بـ Copernicus Sentinel Hub
# ==========================================
SENTINEL_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret_here

# ==========================================
# إعدادات التخزين السحابي (AWS S3)
# ==========================================
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ==========================================
# مفتاح التوقيع الرقمي للبيانات (Audit-Ready HMAC)
# ==========================================
SATELLITE_SIGNING_SECRET=generate_a_very_strong_random_secret_key_here

# ==========================================
# إعدادات بوابة الدفع (Paymob)
# ==========================================
SMART_REPORT_PRICE_EGP=150
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_SECRET_KEY=your_paymob_secret_key
PAYMOB_PUBLIC_KEY=your_paymob_public_key
PAYMOB_HMAC=your_paymob_hmac_secret
PAYMOB_CARD_INTEGRATION_ID=your_card_integration_id
PAYMOB_WALLET_INTEGRATION_ID=your_wallet_integration_id

# ==========================================
# إعدادات إرسال التقارير بالبريد (SMTP)
# ==========================================
COMPANY_REPORT_EMAIL=waadnasr144@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sending_email@gmail.com
SMTP_PASS=your_gmail_app_password
