# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env أبداً إلى Git

# من Copernicus Data Space Ecosystem Dashboard > User Settings > OAuth Clients
SENTINEL_CLIENT_ID= sh-d9ee10c4-c640-4042-b1c6-e8fde81bf083
SENTINEL_CLIENT_SECRET= qq0FQHtUIUeintaQ9xUIZ1bNr79n7LOG

# بيانات AWS S3 (استخدم IAM User مخصص بصلاحية s3:PutObject فقط على هذا الـ bucket)
AWS_REGION=eu-central-1
AWS_S3_BUCKET=nilus-climate-assets-bucket-2026
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# منفذ تشغيل الخادم
PORT=3001

# نطاق الواجهة الأمامية المسموح له بالاتصال (لضبط CORS في الإنتاج)
FRONTEND_ORIGIN=https://your-domain.com

# --- Paymob (بوابة الدفع — بطاقات + فودافون كاش) ---
# من Paymob Dashboard > Settings > Account Info / API Keys
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# من Developers > Payment Integrations — رقم كل integration يمثل وسيلة دفع
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
# غيّره فقط لو تعمل خارج مصر (ksa/uae/oman/pakistan)
PAYMOB_BASE_URL=https://accept.paymob.com

# سعر تقرير الزراعة الذكية بالجنيه المصري
SMART_REPORT_PRICE_EGP=150

# --- قاعدة البيانات (PostgreSQL) — مطلوبة لطبقة الامتثال والتدقيق ---
DATABASE_URL=postgresql://user:password@host:5432/nilus_eca
DATABASE_SSL=true

# --- التوثيق (JWT) ---
# ولّد قيمة عشوائية طويلة، مثلاً: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- التوقيع الرقمي لسجلات الأقمار الصناعية ---
# ولّد قيمة عشوائية طويلة منفصلة عن JWT_SECRET، مثلاً: openssl rand -hex 32
SATELLITE_SIGNING_SECRET=


